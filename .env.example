# ─────────────────────────────────────────────────────────────────────────────
# Single shared environment file for BOTH the backend and the frontend.
# Copy to .env and fill in real values:  cp .env.example .env
#
# Loaded by:
#   • backend  → backend/src/config/index.js (dotenv, from this root path)
#   • frontend → Vite (envDir points here; ONLY VITE_-prefixed vars are exposed
#                to the browser bundle — backend secrets stay server-side).
#
# Every variable is required at startup (each app fails fast with a clear error
# if any are missing), except where noted. No environment-specific value is
# hardcoded in source. NEVER prefix a secret with VITE_ (that would expose it).
# ─────────────────────────────────────────────────────────────────────────────

# ═══ BACKEND ═════════════════════════════════════════════════════════════════

# ─── Server ───────────────────────────────────────────────
NODE_ENV=development
PORT=3001
# Origin of the frontend (always allowed by CORS). Vite dev defaults to 5173.
CLIENT_URL=http://localhost:5173
# Logging verbosity: error | warn | info | debug
LOG_LEVEL=info

# ─── MongoDB ──────────────────────────────────────────────
# Include a database name (e.g. /healthcareDB). For local dev without Atlas,
# leave blank and run: npm run dev:memory
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/healthcareDB

# ─── Auth (Clerk) ─────────────────────────────────────────
# From https://dashboard.clerk.com → API keys. CLERK_PUBLISHABLE_KEY must equal
# VITE_CLERK_PUBLISHABLE_KEY below.
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key

# ─── LLM provider ─────────────────────────────────────────
# AVAILABLE_MODELS is "id" or "id:Human Label", comma-separated; DEFAULT_MODEL
# must be one of its ids. FALLBACK_MODEL (optional) is tried automatically when
# the selected model fails (rate limit, outage, timeout). GROQ_API_KEY is
# required only when NODE_ENV=production; otherwise the AI layer uses safe
# built-in fallback replies.
LLM_PROVIDER=groq
GROQ_API_KEY=your-groq-api-key
GROQ_BASE_URL=https://api.groq.com/openai/v1
DEFAULT_MODEL=openai/gpt-oss-20b
FALLBACK_MODEL=openai/gpt-oss-120b
AVAILABLE_MODELS=openai/gpt-oss-20b:GPT-OSS 20B,openai/gpt-oss-120b:GPT-OSS 120B

# ─── CORS ─────────────────────────────────────────────────
# Both OPTIONAL. The single-origin Render deploy serves the SPA and API from the
# same URL, so no CORS config is needed there (CLIENT_URL falls back to Render's
# RENDER_EXTERNAL_URL automatically). Use these only for a split setup or a
# custom domain: comma-separated extra origins, and wildcard host suffixes.
CORS_ORIGINS=
CORS_ALLOWED_ORIGIN_SUFFIXES=

# ═══ FRONTEND (Vite — only VITE_-prefixed vars reach the browser) ════════════

# OPTIONAL. For split local dev (Vite :5173 + API :3001) point this at the
# backend origin, as below. In the single-origin Render deploy the SPA and API
# share one URL, so leave it UNSET and requests go same-origin to a relative /api.
VITE_API_URL=http://localhost:3001
VITE_APP_ENV=development
# Must equal CLERK_PUBLISHABLE_KEY above.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
VITE_LLM_PROVIDER=groq
VITE_DEFAULT_MODEL=openai/gpt-oss-20b
VITE_AVAILABLE_MODELS=openai/gpt-oss-20b:GPT-OSS 20B,openai/gpt-oss-120b:GPT-OSS 120B
# Optional: Vite dev-server port (Vite default when unset).
# VITE_DEV_PORT=5173
